{
  "name": "agendamento-mvp",
  "version": "1.0.0",
  "description": "Sistema de Agendamento MVP - Backend Flask + Frontend React",
  "scripts": {
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "backend": "py run.py",
    "frontend": "cd frontend && npm run dev",
    "install:all": "cd backend && pip install -r requirements.txt && cd ../frontend && npm install",
    "build": "cd frontend && npm run build",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "jest": "^30.1.3",
    "supertest": "^7.1.4"
  },
  "dependencies": {
    "postgres": "^3.4.7"
  }
}
